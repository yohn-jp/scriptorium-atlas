{
  "name": "scriptorium-atlas",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "generate": "pnpm --filter @scriptorium-atlas/contracts generate",
    "typecheck": "pnpm build:packages && pnpm -r --if-present typecheck",
    "test": "pnpm build:packages && pnpm -r --if-present test && node --test tests/verification/*.test.mjs",
    "build:atlas": "pnpm --filter @scriptorium-atlas/atlas... --filter @scriptorium-atlas/persistence... build && pnpm --filter @scriptorium-atlas/standalone build:atlas",
    "build:story": "pnpm --filter @scriptorium-atlas/story-knowledge... --filter @scriptorium-atlas/persistence... build && pnpm --filter @scriptorium-atlas/standalone build:story",
    "build:combined": "pnpm build:packages && pnpm --filter @scriptorium-atlas/standalone build:combined",
    "dev:atlas": "pnpm --filter @scriptorium-atlas/standalone dev:atlas",
    "dev:story": "pnpm --filter @scriptorium-atlas/standalone dev:story",
    "dev:combined": "pnpm --filter @scriptorium-atlas/standalone dev:combined",
    "build:packages": "pnpm -r --if-present build",
    "build:profiles": "pnpm build:packages && pnpm --filter @scriptorium-atlas/standalone build:atlas && pnpm --filter @scriptorium-atlas/standalone build:story && pnpm --filter @scriptorium-atlas/standalone build:combined",
    "test:e2e:host": "node scripts/verification/run-browser-e2e.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "24.10.1",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "fflate": "0.8.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
