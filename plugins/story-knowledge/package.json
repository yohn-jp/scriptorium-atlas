{
  "name": "@scriptorium-atlas/story-knowledge",
  "version": "1.0.0",
  "description": "Standalone Story Knowledge plugin and Graph Provider for Scriptorium Atlas",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "package.json",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./metadata": {
      "types": "./dist/metadata.d.ts",
      "import": "./dist/metadata.js"
    },
    "./provider": {
      "types": "./dist/provider.d.ts",
      "import": "./dist/provider.js"
    },
    "./ui": {
      "types": "./dist/ui/index.d.ts",
      "import": "./dist/ui/index.js"
    },
    "./domain": {
      "types": "./dist/domain/public.d.ts",
      "import": "./dist/domain/public.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:browser": "node ./tests/browser-acceptance.mjs"
  },
  "dependencies": {
    "@scriptorium-atlas/contracts": "workspace:*",
    "yaml": "2.9.1"
  },
  "peerDependencies": {
    "react": "18.3.1"
  },
  "devDependencies": {
    "@types/react": "18.3.31",
    "react": "18.3.1",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
